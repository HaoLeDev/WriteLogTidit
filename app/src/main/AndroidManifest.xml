<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- NFC Permissions -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.NFC_TRANSACTION_EVENT" />
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />

    <!-- Package Visibility Queries for Android 11+ up to Android 16 (HyperOS 3) -->
    <queries>
        <package android:name="com.lgcns.didid" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <application
        android:name=".TiditApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.TiditAccessLog">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.TiditAccessLog">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Optional NFC intent in case phone directly scans a tag -->
            <intent-filter>
                <action android:name="android.nfc.action.TAG_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Accessibility Service to monitor Tidit in background -->
        <service
            android:name=".service.TiditAccessibilityService"
            android:exported="true"
            android:label="Tidit Auto Logger"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Notification Listener Service to capture Tidit door unlock notifications -->
        <service
            android:name=".service.TiditNotificationListener"
            android:exported="true"
            android:label="Tidit Notification Logger"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- NFC Transaction Receiver for background card swipe detection -->
        <receiver
            android:name=".receiver.NfcTransactionReceiver"
            android:exported="true"
            android:permission="android.permission.NFC_TRANSACTION_EVENT">
            <intent-filter>
                <action android:name="android.nfc.action.TRANSACTION_DETECTED" />
                <data android:scheme="nfc" android:host="secure-element" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.TRANSACTION_DETECTED" />
            </intent-filter>
        </receiver>

        <!-- FileProvider for exporting and sharing CSV files -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
